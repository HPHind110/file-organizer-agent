      ],
      "extensions": [
        ".pdf",
        ".docx",
        ".pptx",
        ".txt"
      ]
    },
    {
      "category": "Screenshots",
      "tokens": [
        "screenshot",
        "screen shot",
        "ảnh chụp màn hình"
